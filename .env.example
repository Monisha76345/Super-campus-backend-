# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# JWT (access + refresh). JWT_SECRET / JWT_EXPIRES_IN are aliases for access token settings.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_SECRET=change-me-access-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
# Optional: blacklist TTL in seconds (7d = 604800; defaults from JWT_REFRESH_EXPIRES_IN if unset)
REFRESH_EXPIRY=604800

# CORS (comma-separated origins, or leave unset to allow any origin with credentials)
# CORS_ORIGIN=http://localhost:8081

# One MySQL database, same keys as CDRMS. Every campus uses DB_DATABASE.
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DATABASE=supercampus
DB_SYNCHRONIZE=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=supercampus

# MinIO
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=supercampus-storage

# Development login for Swagger and the mobile app.
# Used only when that email is not already on the campus directory. Ignored when NODE_ENV=production.
# College accounts come from POST /api/v1/users/import. The CSV includes the college password.
LOCAL_LOGIN_EMAIL=dr@supercampus.edu
LOCAL_LOGIN_PASSWORD=change-me
LOCAL_LOGIN_USER_ID=local-dev-user
LOCAL_LOGIN_FULL_NAME=Campus Scholar
LOCAL_LOGIN_ROLE=student
DEFAULT_TENANT_ID=nmit
DEFAULT_CAMPUS_NAME=NMIT Bengaluru
# Student, faculty, and admin mail must end with this domain.
NMIT_EMAIL_DOMAIN=nmit.ac.in

NOTIFICATION_IN_APP_MAX_PER_USER=100
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@localhost
# SMS_PROVIDER=none

TENANT_HEADER=X-Tenant-Id
